import pygame
import random

# Initialize & Setup
pygame.init()
WIDTH, HEIGHT = 800, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Python Space Invaders")
clock = pygame.time.Clock()

# Colors
WHITE = (255, 255, 255)
GREEN = (0, 255, 0)
RED = (255, 0, 0)
BLACK = (0, 0, 0)

# Player setup
player = pygame.Rect(WIDTH//2, HEIGHT - 50, 40, 20)
player_speed = 7
bullets = []

# Enemy setup
enemies = []
for row in range(5):
    for col in range(10):
        enemies.append(pygame.Rect(100 + col * 60, 50 + row * 40, 30, 20))
enemy_direction = 1
enemy_speed = 2

def game_loop():
    global enemy_direction, enemy_speed
    score = 0
    running = True

    while running:
        screen.fill(BLACK)
        
        # 1. Event Handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE:
                    bullets.append(pygame.Rect(player.centerx - 2, player.top, 4, 10))

        # 2. Player Movement
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and player.left > 0:
            player.x -= player_speed
        if keys[pygame.K_RIGHT] and player.right < WIDTH:
            player.x += player_speed

        # 3. Bullet Logic
        for b in bullets[:]:
            b.y -= 10
            if b.bottom < 0:
                bullets.remove(b)

        # 4. Enemy Movement
        move_down = False
        for e in enemies:
            e.x += enemy_speed * enemy_direction
            if e.right >= WIDTH or e.left <= 0:
                move_down = True
        
        if move_down:
            enemy_direction *= -1
            for e in enemies:
                e.y += 10

        # 5. Collision Detection
        for b in bullets[:]:
            for e in enemies[:]:
                if b.colliderect(e):
                    bullets.remove(b)
                    enemies.remove(e)
                    score += 10
                    break

        # 6. Drawing
        pygame.draw.rect(screen, GREEN, player)
        for e in enemies:
            pygame.draw.rect(screen, RED, e)
        for b in bullets:
            pygame.draw.rect(screen, WHITE, b)

        # Check Win/Loss
        if not enemies:
            print(f"You Win! Score: {score}")
            running = False
        for e in enemies:
            if e.colliderect(player) or e.bottom >= HEIGHT:
                print(f"Game Over! Score: {score}")
                running = False

        pygame.display.flip()
        clock.tick(60)

game_loop()
pygame.quit()
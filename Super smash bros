import pygame
import random
import sys

# --- Constants ---
WIDTH, HEIGHT = 1000, 600
GRAVITY, FRICTION, FPS = 0.7, 0.92, 60

class Projectile:
    def __init__(self, x, y, direction, owner_color, speed, damage):
        self.rect = pygame.Rect(x, y, 25, 25)
        self.vel_x = direction * speed
        self.active = True
        self.damage = damage
    def update(self):
        self.rect.x += self.vel_x
        if self.rect.x < -50 or self.rect.x > WIDTH + 50: self.active = False

class Player:
    def __init__(self, x, y, color, controls, p_type, name):
        self.start_pos = (x, y)
        self.rect = pygame.Rect(x, y, 45, 65)
        self.hand_rect = pygame.Rect(0, 0, 30, 30)
        self.color, self.controls, self.name = color, controls, name
        self.lives, self.face_right = 3, True
        self.is_attacking, self.atk_timer = False, 0
        self.is_shielding = False
        self.projectiles = []
        self.p_type = p_type
        # Stats based on Ninja vs Tank
        if p_type == "NINJA": self.speed_mult, self.weight, self.max_jumps = 1.4, 0.8, 3
        elif p_type == "TANK": self.speed_mult, self.weight, self.max_jumps = 0.7, 1.7, 2
        else: self.speed_mult, self.weight, self.max_jumps = 1.0, 1.0, 2
        self.reset_round()

    def reset_round(self):
        self.rect.topleft = self.start_pos
        self.vel_x = self.vel_y = self.percentage = 0
        self.jumps = self.max_jumps
        self.projectiles = []

    def update(self, keys, platforms):
        # Index 3 is the DOWN key in our list
        self.is_shielding = keys[self.controls[3]] 
        
        if not self.is_shielding:
            # Index 0 = Left, Index 1 = Right
            if keys[self.controls[0]]: self.vel_x -= 1.0 * self.speed_mult; self.face_right = False
            if keys[self.controls[1]]: self.vel_x += 1.0 * self.speed_mult; self.face_right = True
        
        self.vel_x *= FRICTION
        self.vel_y += GRAVITY * self.weight
        self.rect.x += self.vel_x
        self.rect.y += self.vel_y

        for plat in platforms:
            if self.rect.colliderect(plat) and self.vel_y > 0 and self.rect.bottom - self.vel_y <= plat.top:
                self.rect.bottom, self.vel_y, self.jumps = plat.top, 0, self.max_jumps

        if self.is_attacking:
            self.atk_timer -= 1
            if self.atk_timer <= 0: self.is_attacking = False
        
        offset = 55 if self.face_right else -85 if self.is_attacking else 25 if self.face_right else -25
        self.hand_rect.center = (self.rect.centerx + offset, self.rect.centery)
        for p in self.projectiles[:]: 
            p.update()
            if not p.active: self.projectiles.remove(p)

    def attack(self, opponent, keys, is_special):
        if self.is_shielding: return
        dir = 1 if self.face_right else -1
        if is_special:
            # Index 2 is the UP key
            if keys[self.controls[2]]: 
                self.vel_y = -19 * (1/self.weight); self.is_attacking, self.atk_timer = True, 15
            else: # Shoot Pumpkin
                self.projectiles.append(Projectile(self.rect.centerx, self.rect.centery, dir, (255,140,0), 10, 12))
        else: # Normal Whack
            self.is_attacking, self.atk_timer = True, 10
            if self.hand_rect.colliderect(opponent.rect) and not opponent.is_shielding:
                self.hit(opponent, 11)

    def hit(self, opponent, damage):
        opponent.percentage += damage
        launch = (opponent.percentage / (18 * opponent.weight)) ** 2.2
        direction = 1 if self.rect.centerx < opponent.rect.centerx else -1
        opponent.vel_x, opponent.vel_y = direction * (8 + launch), -(6 + launch * 0.6)

def main():
    pygame.init()
    screen = pygame.display.set_mode((WIDTH, HEIGHT))
    font = pygame.font.SysFont("Impact", 45)
    big_font = pygame.font.SysFont("Impact", 80)
    clock = pygame.time.Clock()

    while True: # Main Restart Loop
        selected_stage = None
        while selected_stage is None:
            screen.fill((10, 10, 20))
            btn1 = pygame.Rect(200, 250, 250, 100); btn2 = pygame.Rect(550, 250, 250, 100)
            pygame.draw.rect(screen, (34, 139, 34), btn1); pygame.draw.rect(screen, (70, 70, 90), btn2)
            screen.blit(font.render("JUNGLE", True, (255,255,255)), (255, 275))
            screen.blit(font.render("CASTLE", True, (255,255,255)), (605, 275))
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.MOUSEBUTTONDOWN:
                    if btn1.collidepoint(event.pos): selected_stage = {"bg": (20,50,20), "plats": [pygame.Rect(200, 480, 600, 40)]}
                    if btn2.collidepoint(event.pos): selected_stage = {"bg": (30,30,40), "plats": [pygame.Rect(100, 500, 800, 40), pygame.Rect(300, 350, 400, 20)]}
            pygame.display.flip()

        # [0:Left, 1:Right, 2:Up, 3:Down, 4:Atk, 5:Spec]
        p1_ctrl = [pygame.K_a, pygame.K_d, pygame.K_w, pygame.K_s, pygame.K_SPACE, pygame.K_LSHIFT]
        p2_ctrl = [pygame.K_LEFT, pygame.K_RIGHT, pygame.K_UP, pygame.K_DOWN, pygame.K_m, pygame.K_n]
        p1 = Player(300, 300, (200, 0, 0), p1_ctrl, "TANK", "PLAYER 1")
        p2 = Player(650, 300, (0, 100, 255), p2_ctrl, "NINJA", "PLAYER 2")

        game_active = True
        winner_name = ""

        while game_active:
            screen.fill(selected_stage["bg"])
            keys = pygame.key.get_pressed()
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.KEYDOWN:
                    # Index 2 = Jump
                    if event.key == p1.controls[2] and p1.jumps > 0: p1.vel_y = -15; p1.jumps -= 1
                    if event.key == p2.controls[2] and p2.jumps > 0: p2.vel_y = -15; p2.jumps -= 1
                    # Index 4 = Normal Atk
                    if event.key == p1.controls[4]: p1.attack(p2, keys, False)
                    if event.key == p2.controls[4]: p2.attack(p1, keys, False)
                    # Index 5 = Special Atk
                    if event.key == p1.controls[5]: p1.attack(p2, keys, True)
                    if event.key == p2.controls[5]: p2.attack(p1, keys, True)

            p1.update(keys, selected_stage["plats"]); p2.update(keys, selected_stage["plats"])

            for atk, vic in [(p1, p2), (p2, p1)]:
                for pr in atk.projectiles:
                    if pr.rect.colliderect(vic.rect) and not vic.is_shielding:
                        atk.hit(vic, pr.damage); pr.active = False

            for p in [p1, p2]:
                if p.rect.y > HEIGHT+50 or p.rect.y < -300 or p.rect.x < -150 or p.rect.x > WIDTH+150:
                    p.lives -= 1
                    if p.lives > 0: p1.reset_round(); p2.reset_round(); pygame.time.delay(1000)
                    else:
                        winner_name = "PLAYER 2" if p == p1 else "PLAYER 1"
                        game_active = False

            for plat in selected_stage["plats"]: pygame.draw.rect(screen, (60, 60, 60), plat)
            for p in [p1, p2]:
                pygame.draw.rect(screen, p.color, p.rect, border_radius=10)
                if p.is_shielding: pygame.draw.circle(screen, (200, 200, 255), p.rect.center, 50, 3)
                pygame.draw.rect(screen, (255, 220, 180), p.hand_rect, border_radius=6)
                for pr in p.projectiles: pygame.draw.circle(screen, (255, 140, 0), pr.rect.center, 12)

            screen.blit(font.render(f"P1: {p1.percentage}% | Stocks: {p1.lives}", True, (255,255,255)), (60, 530))
            screen.blit(font.render(f"P2: {p2.percentage}% | Stocks: {p2.lives}", True, (255,255,255)), (600, 530))
            pygame.display.flip(); clock.tick(FPS)

        # WINNER SCREEN
        waiting = True
        while waiting:
            screen.fill((0, 0, 0))
            txt = big_font.render(f"{winner_name} WINS!", True, (255, 215, 0))
            retry = font.render("Press ENTER to Restart", True, (255, 255, 255))
            screen.blit(txt, (WIDTH//2 - 250, HEIGHT//2 - 100))
            screen.blit(retry, (WIDTH//2 - 200, HEIGHT//2 + 50))
            for event in pygame.event.get():
                if event.type == pygame.QUIT: pygame.quit(); sys.exit()
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_RETURN: waiting = False
            pygame.display.flip()

if __name__ == "__main__": main()
